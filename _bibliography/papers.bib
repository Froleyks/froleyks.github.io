@inproceedings{DBLP:conf/fmcad/BiereFFF24,
  title = {Clausal Equivalence Sweeping},
  booktitle = {Formal Methods in Computer-Aided Design, {{FMCAD}} 2024, Prague, Czech Republic, October 15-18, 2024},
  author = {Biere, Armin and Fazekas, Katalin and Fleury, Mathias and Froleyks, Nils},
